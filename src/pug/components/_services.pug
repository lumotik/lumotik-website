- var servicesList = (lang === "en" ? servicesEn : servicesAr);

section#services.services
  .container
    .services__wrapper
      .services__header(data-aos="fade-up")
        p.services__subtitle= (lang === "en" ? "Capabilities & Expertise" : "خدماتنا وخبراتنا")
        h2.services__title
          if lang === "en"
            | Engineering high-impact digital solutions.
          else
            | نصنع حلولاً برمجية وتصميمية تصنع الفارق.
        p.services__description= (lang === "en" ? "From napkin concept to enterprise deployment, we provide end-to-end craft across the modern digital spectrum." : "من الفكرة المبدئية إلى الإطلاق الشامل، نقدم حلولاً تقنية متكاملة تضمن تفوق علامتك التجارية.")

      .services__cards
        each service, index in servicesList
          .services__card(data-aos="fade-up" data-aos-delay=(index * 100))
            .services__card-icon-box
              i(class=service.icon)
            .services__body
              h3.services__card-title= service.title
              p.services__card-description= service.description
            .services__card-tag
              i(class="fa-solid fa-terminal me-1")
              span= service.tag

